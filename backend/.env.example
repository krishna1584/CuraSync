# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/curasync?retryWrites=true&w=majority

# JWT Configuration
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to start if this is missing or left as a placeholder.
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_EXPIRE=7d

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
# Optional extra allowed origins, comma-separated (no wildcards), e.g. a Vercel preview URL
ALLOWED_ORIGINS=

# Server Configuration
PORT=5000
NODE_ENV=development

# Production Example (for Render deployment):
# NODE_ENV=production
# FRONTEND_URL=https://your-frontend-url.vercel.app
# MONGODB_URI=mongodb+srv://...
# JWT_SECRET=generate-a-secure-random-string

# Email (optional). Used for appointment emails, and for verification codes if enabled below.

# Email verification with one-time codes. OFF by default: anyone can register and
# sign in with any address (e.g. test1@gmail.com) and no codes are emailed.
# Set to true (and fill in the EMAIL_* values) to require real, verified emails.
EMAIL_VERIFICATION_ENABLED=false

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
